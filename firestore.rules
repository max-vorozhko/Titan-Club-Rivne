rules_version = '2';

// Лідерборд Titan Run.
// Кожен гравець входить анонімно і може писати лише власний документ scores/{uid}.
// Результат можна тільки покращити (або залишити той самий км і змінити ім'я).
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validScore(request.resource.data)
        && dayStartOk('km')
        && (resource == null || request.resource.data.km >= resource.data.km);
      allow delete: if false;
    }

    // Недільна пробіжка: найкращий час гравця за тиждень, sunday/{понеділок YYYY-MM-DD}/{5k|10k}/{uid}.
    // Писати можна лише в поточний тиждень (минулі тижні — незмінний архів) і лише покращувати час.
    match /sunday/{week}/{dist}/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && dist in ['5k', '10k']
        && isCurrentWeek(week)
        && validSunday(request.resource.data, dist == '5k' ? 5 : 10)
        && dayStartOk('time')
        && (resource == null || request.resource.data.time <= resource.data.time);
      allow delete: if false;
    }

    // dayStart — результат на початок доби (для позначок ▲/▼/NEW у таблицях): у нового запису null,
    // далі — попередній результат або попередній dayStart. Поле необов'язкове (старі версії гри його не пишуть).
    function dayStartOk(field) {
      return !('dayStart' in request.resource.data)
        || (resource == null
          ? request.resource.data.dayStart == null
          : (request.resource.data.dayStart == resource.data[field]
            || request.resource.data.dayStart == resource.data.get('dayStart', resource.data[field])));
    }

    // Запас у добу з кожного боку покриває різницю між UTC і київським часом
    function isCurrentWeek(week) {
      return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > timestamp.date(int(week[0:4]), int(week[5:7]), int(week[8:10])) - duration.value(1, 'd')
        && request.time < timestamp.date(int(week[0:4]), int(week[5:7]), int(week[8:10])) + duration.value(8, 'd');
    }

    // Найшвидший можливий темп у грі ≈ 3:26/км (прискорення + гель), тож менше 200 с/км не буває
    function validSunday(d, km) {
      return d.keys().hasOnly(['name', 'time', 'stumbles', 'boost', 'dayStart', 'updatedAt'])
        && (!('boost' in d) || d.boost is bool)
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.time is int && d.time >= km * 200 && d.time <= km * 1800
        && d.stumbles is int && d.stumbles >= 0 && d.stumbles <= 1000
        && d.updatedAt == request.time;
    }

    // Трейл «Підготовка до Житомирських вертикалей»: найкращий час гравця, trail/{7k|13k|26k}/runs/{uid}
    match /trail/{dist}/runs/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && dist in ['7k', '13k', '26k']
        && validTrail(request.resource.data, dist == '7k' ? 7 : (dist == '13k' ? 13 : 26))
        && dayStartOk('time')
        && (resource == null || request.resource.data.time <= resource.data.time);
      allow delete: if false;
    }

    // «Малюнок дня»: найкращий результат гравця за малюнок, draw/{titan|heart|star|rivne}/runs/{uid}.
    // key = бали·10000 − час у десятих секунди: більше — краще (спершу бали, при рівних швидший).
    match /draw/{id}/runs/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && id in ['titan', 'heart', 'star', 'rivne']
        && validDraw(request.resource.data, id)
        && dayStartOk('key')
        && (resource == null || request.resource.data.key >= resource.data.key);
      allow delete: if false;
    }

    // Довжина контуру малюнка в умовних одиницях гри (js/draw.js)
    function drawLen(id) {
      return id == 'titan' ? 2646 : (id == 'heart' ? 2107 : (id == 'star' ? 2446 : 3440));
    }

    // Бали ≤ 700·покриття + 300, тож покриття ≥ (бали−300)/700. Бігун не швидший за 470 од/с, звідси мінімальний час
    // (з 10% запасу): t/10 ≥ 0.9·покриття·довжина/470.
    function validDraw(d, id) {
      return d.keys().hasOnly(['name', 'points', 't', 'key', 'dayStart', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.points is int && d.points >= 0 && d.points <= 1000
        && d.t is int && d.t >= 10 && d.t <= 36000
        && d.t * 329000 >= 9 * (d.points - 300) * drawLen(id)
        && d.key == d.points * 10000 - d.t
        && d.updatedAt == request.time;
    }

    // Навіть з темпом, гелем і на спуску швидше ~2:40/км не буває, тож менше 150 с/км відхиляємо
    function validTrail(d, km) {
      return d.keys().hasOnly(['name', 'time', 'stumbles', 'boost', 'dayStart', 'updatedAt'])
        && (!('boost' in d) || d.boost is bool)
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.time is int && d.time >= km * 150 && d.time <= km * 3600
        && d.stumbles is int && d.stumbles >= 0 && d.stumbles <= 2000
        && d.updatedAt == request.time;
    }

    // ---------- Бусти «Супер-кросівки» й промокоди ----------

    // ---------- Адміністратори (сторінка admin.html, вхід через Google) ----------

    // Підтверджений Google email того, хто ввійшов (у анонімних гравців його немає)
    function verifiedEmail() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        ? request.auth.token.get('email', '')
        : '';
    }

    // Список адмінів — колекція admins/{email} з полем role: "owner" або "admin".
    // Її створює власник вручну у Firebase Console, тож email-и не потрапляють у публічний репозиторій.
    function adminRole() {
      return verifiedEmail() != ''
        && exists(/databases/$(database)/documents/admins/$(verifiedEmail()))
        ? get(/databases/$(database)/documents/admins/$(verifiedEmail())).data.role
        : '';
    }

    // Власник: промокоди + усе, що може адмін клубу.
    // Старий анонімний ідентифікатор пристрою лишається, поки власник не перейде на вхід через Google.
    function isOwner() {
      return request.auth != null
        && (request.auth.uid in ['L5F6ELplpsaOGeqSiOqiyoYPTBl1'] || adminRole() == 'owner');
    }

    // Адміни клубу: відмічають відвідуваність недільних пробіжок і ведуть список атлетів
    function isClubAdmin() {
      return request.auth != null && adminRole() in ['owner', 'admin'];
    }

    // Кожен бачить лише свій запис (адмінка дізнається з нього роль); змінити список не може ніхто з сайту
    match /admins/{email} {
      allow get: if verifiedEmail() != '' && verifiedEmail() == email;
    }

    // Промокоди генерує лише власник
    function isAdmin() {
      return isOwner();
    }

    // Вхід гравців через Google: logins/{uid}. Пошту підтверджує сам Google (токен), прив'язку до атлета
    // клубу (athleteId) ставить лише адмін. Прив'язаний гравець бачить справжні імена у вкладці «Клуб».
    function memberAthlete() {
      return request.auth != null
        && exists(/databases/$(database)/documents/logins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/logins/$(request.auth.uid)).data.get('athleteId', '') : '';
    }

    function isLinkedMember() {
      return memberAthlete() != '';
    }

    function validLoginText(d) {
      return d.displayName is string && d.displayName.size() <= 100
        && d.nick is string && d.nick.size() <= 20;
    }

    match /logins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isClubAdmin());
      allow list: if isClubAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && verifiedEmail() != ''
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'nick', 'createdAt', 'lastSeen'])
        && request.resource.data.email == verifiedEmail()
        && validLoginText(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time;
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'nick', 'lastSeen'])
          && validLoginText(request.resource.data)
          && request.resource.data.lastSeen == request.time)
        || (isClubAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['athleteId', 'linkedAt', 'linkedBy'])
          && (!('athleteId' in request.resource.data)
            || (request.resource.data.athleteId is string
              && exists(/databases/$(database)/documents/athletes/$(request.resource.data.athleteId))
              && request.resource.data.linkedAt == request.time
              && request.resource.data.linkedBy == verifiedEmail()))));
      allow delete: if isClubAdmin();
    }

    // Атлети клубу з реальними іменами: бачать адміни та прив'язані учасники клубу, змінюють лише адміни
    match /athletes/{id} {
      allow read: if isClubAdmin() || isLinkedMember();
      allow delete: if isClubAdmin();
      allow create, update: if isClubAdmin()
        && request.resource.data.keys().hasOnly(['name', 'persona', 'emoji', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.persona is string && request.resource.data.persona.size() <= 40
        && request.resource.data.emoji is string && request.resource.data.emoji.size() <= 16
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Недільні пробіжки runs/{рік-тиждень}: дата, кілометри, хто був і хто вніс — лише для адмінів
    match /runs/{id} {
      allow read, delete: if isClubAdmin();
      allow create, update: if isClubAdmin()
        && id.matches('^[0-9]{4}-[0-9]{1,2}$')
        && request.resource.data.keys().hasOnly(['date', 'km', 'present', 'updatedBy', 'updatedAt'])
        && request.resource.data.date is string
        && (request.resource.data.km == null || (request.resource.data.km is number && request.resource.data.km >= 0 && request.resource.data.km <= 100))
        && request.resource.data.present is list && request.resource.data.present.size() <= 300
        && request.resource.data.updatedBy == verifiedEmail()
        && request.resource.data.updatedAt == request.time;
    }

    // Публічна статистика клубу club/public: лише вигадані персонажі, без реальних імен.
    // Читають усі (вкладка «Клуб» у грі), пишуть лише адміни.
    match /club/public {
      allow read: if true;
      allow create, update: if isClubAdmin()
        && request.resource.data.keys().hasOnly(['athletes', 'runs', 'updatedAt'])
        && request.resource.data.athletes is map
        && request.resource.data.runs is map
        && request.resource.data.updatedAt == request.time;
    }

    // Одноразові промокоди codes/{КОД}. Звичайні гравці не бачать і не перебирають коди:
    // можуть лише «погасити» конкретний код, який знають, і лише разом із нарахуванням буста собі.
    match /codes/{code} {
      allow get, list, delete: if isAdmin();
      allow create: if isAdmin()
        && code.matches('^[A-Z0-9-]{6,40}$')
        && request.resource.data.keys().hasOnly(['used', 'createdAt'])
        && request.resource.data.used == false
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.lastCode == code;
    }

    // Гаманець і бусти гравця profiles/{uid}. Кожен запис — рівно одна з дій, решта полів не змінюється:
    //   • новачок: стартові 50 монет (create), старий профіль без монет: те саме (update);
    //   • промокод: boosts +1 разом із погашенням коду;
    //   • буст на старті: boosts −1 («Супер-кросівки») або heads −1 («Розгін» у «Бігу»);
    //   • заробіток: монети з «Бігу». Приріст не більший, ніж гравець міг зібрати за час після попереднього
    //     нарахування (≤ 1.2 монети/с + 30 запасу; чесний максимум ≈ 0.6/с);
    //   • купівля «Розгону»: −100 монет, heads +1, не більше 5 на добу (buyDay — доба за київським часом, UTC+3).
    match /profiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validProfile(request.resource.data)
        && (
          (request.resource.data.boosts == 0
            && request.resource.data.coins == 50
            && request.resource.data.get('heads', 0) == 0
            && request.resource.data.earnAt == request.time
            && !('lastCode' in request.resource.data)
            && !('buyDay' in request.resource.data) && !('buyN' in request.resource.data))
          // старі версії гри (без гаманця): перший промокод
          || (request.resource.data.boosts == 1
            && !('coins' in request.resource.data)
            && redeemedNow(request.resource.data.lastCode))
        );
      allow update: if request.auth != null && request.auth.uid == uid
        && validProfile(request.resource.data)
        && (
          // гаманець створюється для старого профілю
          (!('coins' in resource.data)
            && request.resource.data.coins == 50
            && request.resource.data.get('heads', 0) == 0
            && request.resource.data.earnAt == request.time
            && same('boosts', 0) && same('lastCode', ''))
          // «Супер-кросівки» на старті
          || (request.resource.data.boosts == resource.data.boosts - 1
            && same('lastCode', '') && sameWallet())
          // «Розгін» на старті
          || (request.resource.data.get('heads', 0) == resource.data.get('heads', 0) - 1
            && same('boosts', 0) && same('lastCode', '') && same('coins', 0) && same('earnAt', null)
            && same('buyDay', 0) && same('buyN', 0))
          // промокод
          || (request.resource.data.boosts == resource.data.boosts + 1
            && request.resource.data.get('lastCode', '') != resource.data.get('lastCode', '')
            && redeemedNow(request.resource.data.lastCode)
            && sameWallet())
          // заробіток монет
          || (resource.data.get('earnAt', null) != null
            && request.resource.data.get('coins', 0) > resource.data.get('coins', 0)
            && request.resource.data.get('coins', 0) - resource.data.get('coins', 0)
              <= 30 + (request.time - resource.data.earnAt).seconds() * 1.2
            && request.resource.data.earnAt == request.time
            && same('boosts', 0) && same('lastCode', '') && same('heads', 0)
            && same('buyDay', 0) && same('buyN', 0))
          // купівля «Розгону»
          || (request.resource.data.get('coins', 0) == resource.data.get('coins', 0) - 100
            && request.resource.data.get('heads', 0) == resource.data.get('heads', 0) + 1
            && request.resource.data.buyDay >= resource.data.get('buyDay', 0)
            && request.resource.data.buyDay <= math.floor((request.time.toMillis() + 10800000) / 86400000)
            && request.resource.data.buyDay >= math.floor((request.time.toMillis() + 10800000) / 86400000) - 1
            && request.resource.data.buyN == (request.resource.data.buyDay == resource.data.get('buyDay', 0)
              ? resource.data.get('buyN', 0) + 1 : 1)
            && request.resource.data.buyN <= 5
            && same('boosts', 0) && same('lastCode', '') && same('earnAt', null))
        );
    }

    // Поле не змінилося (відсутнє поле = значення за замовчуванням)
    function same(field, fallback) {
      return request.resource.data.get(field, fallback) == resource.data.get(field, fallback);
    }

    // Усі поля гаманця без змін
    function sameWallet() {
      return same('coins', 0) && same('heads', 0) && same('earnAt', null) && same('buyDay', 0) && same('buyN', 0);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['boosts', 'lastCode', 'coins', 'heads', 'earnAt', 'buyDay', 'buyN', 'updatedAt'])
        && d.boosts is int && d.boosts >= 0 && d.boosts <= 100
        && (!('lastCode' in d) || (d.lastCode is string && d.lastCode.size() <= 40))
        && (!('coins' in d) || (d.coins is int && d.coins >= 0 && d.coins <= 100000))
        && (!('heads' in d) || (d.heads is int && d.heads >= 0 && d.heads <= 100))
        && (!('earnAt' in d) || d.earnAt is timestamp)
        && (!('buyDay' in d) || d.buyDay is int)
        && (!('buyN' in d) || (d.buyN is int && d.buyN >= 0 && d.buyN <= 5))
        && d.updatedAt == request.time;
    }

    // Код існує, ще не використаний і в цій самій транзакції позначається використаним цим гравцем
    function redeemedNow(code) {
      return code.size() >= 6
        && exists(/databases/$(database)/documents/codes/$(code))
        && get(/databases/$(database)/documents/codes/$(code)).data.used == false
        && getAfter(/databases/$(database)/documents/codes/$(code)).data.usedBy == request.auth.uid;
    }

    function validScore(d) {
      return d.keys().hasOnly(['name', 'km', 'coins', 'time', 'boost', 'dayStart', 'updatedAt'])
        && (!('boost' in d) || d.boost is bool)
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.km is number && d.km > 0 && d.km <= 60
        && d.time is number && d.time > 0
        // Найбільша можлива середня швидкість у грі ≈ 0.263 км/с (максимум + гель); «розгін» максимум не змінює
        && d.km <= d.time * 0.27
        && d.coins is int && d.coins >= 0 && d.coins <= d.km * 120
        && d.updatedAt == request.time;
    }
  }
}
